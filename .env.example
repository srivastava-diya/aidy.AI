# ==============================================================================
# aidy.AI — Environment Configuration
# Copy to .env and fill in what you need. Every key is optional: with none set,
# aidy.AI runs in deterministic offline demo mode using curated benchmark sources.
# ==============================================================================

# --- Live web search (set ONE to switch from offline demo to live retrieval) ---
SERPAPI_API_KEY=""
TAVILY_API_KEY=""
SEARCH_PROVIDER="serpapi"

# --- LLM providers (shown on the Settings page; reserved for CrewAI agents) ---
OPENAI_API_KEY=""
OPENAI_MODEL_NAME="gpt-4o-mini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Execution budgets & limits ---
REQUEST_TIMEOUT_S=15
MAX_SEARCH_RESULTS=5
MAX_AGENT_ITERATIONS=3
MAX_TOKENS_PER_RUN=25000

# --- Persistence (any SQLAlchemy URL, e.g. postgresql://user:pass@host:5432/aidy) ---
DATABASE_URL="sqlite:///data/aidy.db"

# --- Output directories ---
REPORTS_DIR="data/reports"
GENERATED_DATA_DIR="data/generated"
